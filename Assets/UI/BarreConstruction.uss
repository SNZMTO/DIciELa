/* La barre de construction (GDD, section 16) : en bas au centre ; au-dessus, la raison d'un refus de pose. */

.screen {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 16px;
}

.reason {
    margin-bottom: 8px;
    padding: 4px 14px;
    font-size: 20px;
    color: rgb(255, 246, 232);
    background-color: rgba(122, 36, 26, 0.85);
    border-radius: 6px;
}

.reason--hidden {
    display: none;
}

.bar {
    padding: 6px;
    align-items: center;
    background-color: rgba(34, 27, 20, 0.85);
    border-radius: 10px;
}

.bar--hidden {
    display: none;
}

.row {
    flex-direction: row;
    justify-content: center;
}

.button {
    min-width: 120px;
    height: 44px;
    margin: 3px;
    font-size: 18px;
    color: rgb(250, 240, 224);
    background-color: rgb(92, 70, 48);
    border-width: 0;
    border-radius: 6px;
}

.button:hover {
    background-color: rgb(122, 94, 64);
}

/* Le bouton choisi garde sa marque au survol : sans la seconde ligne, .button:hover, plus précis, l'emporterait. */
.button--selected,
.button--selected:hover {
    background-color: rgb(172, 128, 70);
}
