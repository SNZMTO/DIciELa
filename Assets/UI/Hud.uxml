<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="screen" class="ecran" picking-mode="Ignore">
        <Diciela.UI.WoodFrame name="journee" class="journee bloc-cache">
            <ui:VisualElement class="journee-contenu">
                <Diciela.UI.Facet class="applique ciel pan-6 journee-tuile">
                    <ui:VisualElement class="journee-icone" picking-mode="Ignore" />
                </Diciela.UI.Facet>
                <ui:VisualElement class="journee-textes">
                    <ui:VisualElement class="journee-ligne">
                        <ui:Label name="jour" class="t2" />
                        <ui:VisualElement class="journee-point" />
                        <ui:Label name="phase" class="sous-titre" />
                    </ui:VisualElement>
                    <Diciela.UI.DayGauge name="jauge" class="creux pan-3 jauge" />
                </ui:VisualElement>
            </ui:VisualElement>
        </Diciela.UI.WoodFrame>
        <ui:VisualElement name="stock" class="stock bloc-cache" picking-mode="Ignore">
            <ui:VisualElement class="stock-corps" picking-mode="Ignore">
                <ui:VisualElement class="tringle" picking-mode="Ignore">
                    <ui:VisualElement class="tringle-clair" picking-mode="Ignore" />
                    <ui:VisualElement class="tringle-bois" picking-mode="Ignore" />
                    <ui:VisualElement class="tringle-sombre" picking-mode="Ignore" />
                    <Diciela.UI.Facet class="pommeau pommeau-gauche" picking-mode="Ignore" />
                    <Diciela.UI.Facet class="pommeau pommeau-droit" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="fanions" class="fanions" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <Diciela.UI.WoodFrame name="fiche" class="fiche bloc-cache">
            <ui:VisualElement class="fiche-contenu">
                <ui:VisualElement class="fiche-tete">
                    <ui:Label name="fiche-titre" class="t2 fiche-titre" />
                    <Diciela.UI.FeltButton name="fiche-fermer" class="feutre sable pan-6 fiche-fermer">
                        <ui:VisualElement class="fiche-croix" picking-mode="Ignore" />
                    </Diciela.UI.FeltButton>
                </ui:VisualElement>
                <ui:VisualElement name="fiche-stock" class="fiche-stock" />
                <ui:VisualElement name="fiche-poste" class="fiche-poste" />
                <ui:VisualElement name="fiche-actions" class="fiche-actions" />
            </ui:VisualElement>
        </Diciela.UI.WoodFrame>
        <Diciela.UI.WoodFrame name="astuce" class="astuce bloc-cache">
            <ui:VisualElement class="astuce-contenu">
                <Diciela.UI.Facet class="applique lavande pan-6 astuce-tuile">
                    <ui:VisualElement name="astuce-portrait" class="astuce-portrait" picking-mode="Ignore" />
                </Diciela.UI.Facet>
                <ui:Label name="astuce-texte" class="prose astuce-texte" />
            </ui:VisualElement>
        </Diciela.UI.WoodFrame>
        <ui:VisualElement name="bas" class="bas" picking-mode="Ignore">
            <Diciela.UI.Facet name="reason" class="bulle raison bloc-cache" picking-mode="Ignore">
                <ui:Label name="reason-text" class="libelle" picking-mode="Ignore" />
            </Diciela.UI.Facet>
            <Diciela.UI.WoodFrame name="bar" class="barre bloc-cache">
                <ui:VisualElement class="barre-contenu">
                    <ui:VisualElement name="structures" class="cartes" />
                    <ui:VisualElement name="families" class="onglets" />
                </ui:VisualElement>
            </Diciela.UI.WoodFrame>
            <Diciela.UI.WoodFrame name="place-barre" class="barre bloc-cache">
                <ui:VisualElement class="barre-contenu">
                    <ui:VisualElement name="place-encres" class="place-encres" />
                    <ui:VisualElement name="place-modes" class="place-modes" />
                    <ui:VisualElement class="place-options" picking-mode="Ignore">
                        <ui:VisualElement name="place-formes" class="place-formes bloc-cache" />
                        <Diciela.UI.Facet name="place-taille-creux" class="creux pan-4 place-valeur" picking-mode="Ignore">
                            <ui:Label name="place-taille" class="libelle" picking-mode="Ignore" />
                        </Diciela.UI.Facet>
                    </ui:VisualElement>
                    <ui:VisualElement class="place-valeurs" picking-mode="Ignore">
                        <Diciela.UI.Facet name="place-superficie-creux" class="creux pan-4 place-valeur" picking-mode="Ignore">
                            <ui:VisualElement class="place-valeur-icone place-icone-superficie" picking-mode="Ignore" />
                            <ui:Label name="place-superficie" class="libelle" picking-mode="Ignore" />
                        </Diciela.UI.Facet>
                        <Diciela.UI.Facet name="place-marques-creux" class="creux pan-4 place-valeur" picking-mode="Ignore">
                            <ui:VisualElement class="place-valeur-icone place-icone-cartspot" picking-mode="Ignore" />
                            <ui:Label name="place-marques" class="libelle" picking-mode="Ignore" />
                        </Diciela.UI.Facet>
                    </ui:VisualElement>
                </ui:VisualElement>
            </Diciela.UI.WoodFrame>
        </ui:VisualElement>
        <Diciela.UI.FeltButton name="outils" class="feutre sable pan-10 outils bloc-cache">
            <ui:VisualElement class="outils-icone" picking-mode="Ignore" />
            <Diciela.UI.Facet class="creux pan-4 touche" picking-mode="Ignore">
                <ui:Label name="outils-touche" class="touche-texte" picking-mode="Ignore" />
            </Diciela.UI.Facet>
        </Diciela.UI.FeltButton>
        <ui:VisualElement name="roue" class="roue roue-fermee" picking-mode="Ignore">
            <ui:VisualElement name="roue-centre" class="roue-centre" picking-mode="Ignore">
                <Diciela.UI.Facet name="roue-plateau" class="plateau roue-plateau" picking-mode="Ignore" />
                <Diciela.UI.Facet name="roue-bulle" class="bulle roue-bulle bloc-cache" picking-mode="Ignore">
                    <ui:Label name="roue-nom" class="libelle roue-texte" picking-mode="Ignore" />
                    <ui:Label name="roue-suite" class="sous-titre roue-texte" picking-mode="Ignore" />
                </Diciela.UI.Facet>
                <Diciela.UI.FeltButton name="roue-construire" class="feutre sable pan-10 roue-outil roue-haut" picking-mode="Ignore">
                    <ui:VisualElement class="roue-icone marteau" picking-mode="Ignore" />
                    <Diciela.UI.Facet class="creux pan-4 touche" picking-mode="Ignore">
                        <ui:Label name="roue-construire-touche" class="touche-texte" picking-mode="Ignore" />
                    </Diciela.UI.Facet>
                </Diciela.UI.FeltButton>
                <Diciela.UI.FeltButton name="roue-retirer" class="feutre sable pan-10 roue-outil roue-bas" picking-mode="Ignore">
                    <ui:VisualElement class="roue-icone hache" picking-mode="Ignore" />
                    <Diciela.UI.Facet class="creux pan-4 touche" picking-mode="Ignore">
                        <ui:Label name="roue-retirer-touche" class="touche-texte" picking-mode="Ignore" />
                    </Diciela.UI.Facet>
                </Diciela.UI.FeltButton>
                <Diciela.UI.FeltButton name="roue-deplacer" class="feutre sable pan-10 roue-outil roue-droite" picking-mode="Ignore">
                    <ui:VisualElement class="roue-icone fleches" picking-mode="Ignore" />
                    <Diciela.UI.Facet class="creux pan-4 touche" picking-mode="Ignore">
                        <ui:Label name="roue-deplacer-touche" class="touche-texte" picking-mode="Ignore" />
                    </Diciela.UI.Facet>
                </Diciela.UI.FeltButton>
                <Diciela.UI.FeltButton name="roue-chemins" class="feutre sable pan-10 roue-outil roue-gauche" picking-mode="Ignore">
                    <ui:VisualElement class="roue-icone chemins" picking-mode="Ignore" />
                    <Diciela.UI.Facet class="creux pan-4 touche" picking-mode="Ignore">
                        <ui:Label name="roue-chemins-touche" class="touche-texte" picking-mode="Ignore" />
                    </Diciela.UI.Facet>
                </Diciela.UI.FeltButton>
            </ui:VisualElement>
        </ui:VisualElement>
        <Diciela.UI.Facet name="infobulle" class="bulle infobulle bloc-cache" picking-mode="Ignore">
            <ui:Label name="infobulle-titre" class="libelle" picking-mode="Ignore" />
            <ui:Label name="infobulle-suite" class="sous-titre" picking-mode="Ignore" />
        </Diciela.UI.Facet>
    </ui:VisualElement>
</ui:UXML>
