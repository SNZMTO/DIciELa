<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="screen" class="ecran" picking-mode="Ignore">
        <ui:VisualElement name="reverie" class="reverie" picking-mode="Ignore" />
        <Diciela.UI.WoodFrame name="journee" class="journee bloc-cache">
            <ui:VisualElement class="journee-contenu">
                <Diciela.UI.Facet class="applique ciel pan-6 journee-tuile">
                    <ui:VisualElement class="journee-icone" picking-mode="Ignore" />
                </Diciela.UI.Facet>
                <ui:VisualElement class="journee-textes">
                    <ui:VisualElement class="journee-ligne">
                        <ui:Label name="jour" class="t2" />
                        <ui:VisualElement class="journee-point" />
                        <ui:Label name="phase" class="sous-titre" />
                    </ui:VisualElement>
                    <Diciela.UI.DayGauge name="jauge" class="creux pan-3 jauge" />
                </ui:VisualElement>
            </ui:VisualElement>
        </Diciela.UI.WoodFrame>
        <ui:VisualElement name="stock" class="stock bloc-cache" picking-mode="Ignore">
            <ui:VisualElement class="stock-corps" picking-mode="Ignore">
                <ui:VisualElement class="tringle" picking-mode="Ignore">
                    <ui:VisualElement class="tringle-clair" picking-mode="Ignore" />
                    <ui:VisualElement class="tringle-bois" picking-mode="Ignore" />
                    <ui:VisualElement class="tringle-sombre" picking-mode="Ignore" />
                    <Diciela.UI.Facet class="pommeau pommeau-gauche" picking-mode="Ignore" />
                    <Diciela.UI.Facet class="pommeau pommeau-droit" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="fanions" class="fanions" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <Diciela.UI.WoodFrame name="fiche" class="fiche bloc-cache">
            <ui:VisualElement class="fiche-contenu">
                <ui:VisualElement class="fiche-tete">
                    <ui:Label name="fiche-titre" class="t2 fiche-titre" />
                    <Diciela.UI.FeltButton name="fiche-fermer" class="feutre sable pan-6 fiche-fermer">
                        <ui:VisualElement class="fiche-croix" picking-mode="Ignore" />
                    </Diciela.UI.FeltButton>
                </ui:VisualElement>
                <ui:VisualElement name="fiche-stock" class="fiche-stock" />
                <ui:VisualElement name="fiche-poste" class="fiche-poste" />
                <ui:VisualElement name="fiche-actions" class="fiche-actions" />
            </ui:VisualElement>
        </Diciela.UI.WoodFrame>
        <Diciela.UI.WoodFrame name="astuce" class="astuce bloc-cache">
            <ui:VisualElement class="astuce-contenu">
                <Diciela.UI.Facet class="applique lavande pan-6 astuce-tuile">
                    <ui:VisualElement name="astuce-portrait" class="astuce-portrait" picking-mode="Ignore" />
                </Diciela.UI.Facet>
                <ui:Label name="astuce-texte" class="prose astuce-texte" />
            </ui:VisualElement>
        </Diciela.UI.WoodFrame>
        <Diciela.UI.FeltButton name="outils" class="feutre sable pan-10 outils bloc-cache">
            <ui:VisualElement class="outils-icone" picking-mode="Ignore" />
            <Diciela.UI.Facet class="creux pan-4 touche" picking-mode="Ignore">
                <ui:Label name="outils-touche" class="touche-texte" picking-mode="Ignore" />
            </Diciela.UI.Facet>
        </Diciela.UI.FeltButton>
        <Diciela.UI.FeltButton name="prevision" class="feutre lavande pan-8 prevision bloc-cache">
            <ui:VisualElement class="prevision-icone" picking-mode="Ignore" />
            <Diciela.UI.Facet class="creux pan-4 touche" picking-mode="Ignore">
                <ui:Label name="prevision-touche" class="touche-texte" picking-mode="Ignore" />
            </Diciela.UI.Facet>
        </Diciela.UI.FeltButton>
        <Diciela.UI.FeltButton name="carte-outil" class="feutre lin pan-10 carte-outil bloc-cache">
            <Diciela.UI.Facet name="carte-outil-tuile" class="applique pan-6 carte-outil-tuile" picking-mode="Ignore">
                <ui:VisualElement name="carte-outil-icone" class="carte-outil-icone" picking-mode="Ignore" />
            </Diciela.UI.Facet>
            <ui:VisualElement class="carte-outil-textes" picking-mode="Ignore">
                <ui:VisualElement class="carte-outil-tete" picking-mode="Ignore">
                    <ui:Label name="carte-outil-nom" class="nom" picking-mode="Ignore" />
                    <ui:VisualElement name="carte-outil-mode" class="carte-outil-ligne" picking-mode="Ignore">
                        <ui:VisualElement class="carte-outil-point" picking-mode="Ignore" />
                        <ui:VisualElement name="carte-outil-mode-icone" class="carte-outil-mode-icone" picking-mode="Ignore" />
                        <ui:Label name="carte-outil-mode-nom" class="nom" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="carte-outil-puces" class="carte-outil-puces" picking-mode="Ignore" />
                <ui:Label name="carte-outil-raison" class="petit carte-outil-raison bloc-cache" picking-mode="Ignore" />
            </ui:VisualElement>
        </Diciela.UI.FeltButton>
        <ui:VisualElement name="roue" class="roue roue-fermee" picking-mode="Ignore">
            <ui:VisualElement name="roue-centre" class="roue-centre" picking-mode="Ignore">
                <Diciela.UI.Facet name="roue-plateau" class="plateau roue-plateau" picking-mode="Ignore" />
                <ui:VisualElement name="roue-cases" class="roue-boite" picking-mode="Ignore" />
                <ui:VisualElement name="roue-eventail" class="roue-boite" picking-mode="Ignore" />
                <Diciela.UI.Facet name="roue-bulle" class="bulle roue-bulle bloc-cache" picking-mode="Ignore">
                    <ui:Label name="roue-nom" class="libelle roue-texte" picking-mode="Ignore" />
                    <ui:Label name="roue-suite" class="sous-titre roue-texte" picking-mode="Ignore" />
                </Diciela.UI.Facet>
            </ui:VisualElement>
        </ui:VisualElement>
        <Diciela.UI.Facet name="infobulle" class="bulle infobulle bloc-cache" picking-mode="Ignore">
            <ui:Label name="infobulle-titre" class="libelle" picking-mode="Ignore" />
            <ui:Label name="infobulle-suite" class="sous-titre" picking-mode="Ignore" />
        </Diciela.UI.Facet>
        <ui:VisualElement name="roue-vol" class="roue-vol" picking-mode="Ignore" />
        <ui:VisualElement name="curseur-eclaboussure" class="eclaboussure" picking-mode="Ignore" />
        <ui:VisualElement name="curseur" class="curseur bloc-cache" picking-mode="Ignore">
            <ui:VisualElement name="curseur-icone" class="curseur-icone" picking-mode="Ignore" />
            <ui:VisualElement class="curseur-pastilles" picking-mode="Ignore">
                <Diciela.UI.Facet name="curseur-sol" class="pastille curseur-pastille bloc-cache" picking-mode="Ignore">
                    <ui:VisualElement class="curseur-pastille-icone" picking-mode="Ignore" />
                </Diciela.UI.Facet>
                <Diciela.UI.Facet name="curseur-forme" class="pastille curseur-pastille bloc-cache" picking-mode="Ignore">
                    <ui:VisualElement class="curseur-pastille-icone" picking-mode="Ignore" />
                </Diciela.UI.Facet>
                <Diciela.UI.Facet name="curseur-symetrie" class="pastille curseur-pastille bloc-cache" picking-mode="Ignore">
                    <ui:VisualElement class="curseur-pastille-icone" picking-mode="Ignore" />
                </Diciela.UI.Facet>
                <Diciela.UI.Facet name="curseur-refus" class="pastille refus-pastille curseur-pastille bloc-cache" picking-mode="Ignore">
                    <ui:VisualElement class="curseur-refus-trait curseur-refus-montant" picking-mode="Ignore" />
                    <ui:VisualElement class="curseur-refus-trait curseur-refus-descendant" picking-mode="Ignore" />
                </Diciela.UI.Facet>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
