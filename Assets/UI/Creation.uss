/* L'écran de création de la Chimère (GDD, section 6) : un panneau de bois à droite, la ville visible derrière ; une
   ligne par partie, sa pièce puis sa couleur, chacune dans sa fente entre deux boutons dorés ; le bouton qui valide en
   bas. Les images, en facettes comme le pack, sont générées (DICIELA/Interface/Générer les images du menu) et se
   découpent en neuf : les bords gardent leur taille, le milieu s'étire. */

.screen {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-end;
    padding-right: 32px;
}

.panel {
    width: 760px;
    padding: 34px 40px 36px 40px;
    background-image: url("Images/Panneau.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    background-color: rgba(0, 0, 0, 0);
}

.panel--hidden {
    display: none;
}

.title {
    margin-bottom: 14px;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(252, 238, 214);
    text-shadow: 2px 2px 0 rgba(28, 16, 8, 0.85);
}

.row {
    flex-direction: row;
    align-items: center;
    height: 42px;
}

.row-label {
    width: 180px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(244, 226, 198);
    text-shadow: 1px 1px 0 rgba(28, 16, 8, 0.8);
}

.arrow {
    width: 38px;
    height: 34px;
    margin: 0;
    padding: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(62, 38, 18);
    background-image: url("Images/Bouton.png");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(228, 228, 228);
    border-width: 0;
    border-radius: 0;
}

.arrow:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.arrow:active {
    -unity-background-image-tint-color: rgb(186, 186, 186);
}

.choice {
    flex-grow: 1;
    height: 32px;
    margin: 0 6px;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgb(252, 238, 214);
    background-image: url("Images/Fente.png");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
}

.color {
    width: 120px;
    height: 32px;
    margin: 0 6px;
    font-size: 18px;
    -unity-text-align: middle-center;
    color: rgb(232, 214, 186);
    background-image: url("Images/Fente.png");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
}

/* Une ligne sans pièce n'a pas de couleur : ses flèches se cachent, sans décaler les autres. */
.hidden {
    visibility: hidden;
}

.confirm {
    height: 56px;
    margin: 18px 0 0 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 244, 222);
    text-shadow: 2px 2px 0 rgba(60, 34, 14, 0.9);
    background-image: url("Images/Valider.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(232, 232, 232);
    border-width: 0;
    border-radius: 0;
}

.confirm:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.confirm:active {
    -unity-background-image-tint-color: rgb(190, 190, 190);
}
