/* L'écran de création de la Chimère (GDD, section 6), dans la langue du HUD (section 16) : un cadre de bois à droite,
   la Chimère visible dans l'atelier ; une ligne par partie : son nom, sa pièce dans un creux entre deux flèches de
   feutre, puis sa couleur de même ; le grand bouton qui valide en bas. Ici, seulement la place des choses : matières,
   couleurs et textes viennent de Fusion.uss. */

.creation-ecran {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-end;
    padding-right: 24px;
}

.creation-contenu {
    padding: 14px 18px 18px 18px;
}

.creation-titre {
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.row {
    flex-direction: row;
    align-items: center;
    height: 44px;
}

.row-label {
    width: 112px;
}

.arrow {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.fleche-precedent, .fleche-suivant {
    width: 20px;
    height: 20px;
}

.fleche-precedent {
    background-image: url("Icones/precedent.asset");
}

.fleche-suivant {
    background-image: url("Icones/suivant.asset");
}

.choice, .color {
    height: 36px;
    margin: 0 6px;
    align-items: center;
    justify-content: center;
}

.choice {
    width: 190px;
}

.color {
    width: 120px;
}

.palette {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
}

.valeur {
    -unity-text-align: middle-center;
}

/* Une ligne sans pièce n'a pas de couleur : ses flèches et son creux se cachent, sans décaler les autres. */
.hidden {
    visibility: hidden;
}

.creation-valider {
    height: 56px;
    margin-top: 16px;
    align-items: center;
    justify-content: center;
}
