/* Le HUD (GDD, section 16 ; décision 144) : chaque bloc tient à son coin ou à son bord, à 24 px du bord de l'écran,
   20 en haut ; le milieu reste libre. Ici, seulement la place des blocs : leurs matières, leurs couleurs et leurs
   textes viennent de Fusion.uss. */

.ecran {
    flex-grow: 1;
}

/* La journée, en haut à gauche. */

.journee {
    position: absolute;
    left: 24px;
    top: 20px;
}

.journee-contenu {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px 10px 10px;
}

.journee-tuile {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

/* Une petite vie (HudLife) : le soleil tourne lentement, un tour par minute. */
.journee-icone {
    width: 42px;
    height: 42px;
    background-image: url("Icones/soleil.asset");
    --tour: 6;
}

.journee-textes {
    margin-left: 12px;
}

.journee-ligne {
    flex-direction: row;
    align-items: center;
}

.journee-point {
    width: 4px;
    height: 4px;
    margin: 2px 8px 0 8px;
    background-color: var(--douce);
}

.jauge {
    width: 176px;
    height: 16px;
    margin-top: 10px;
}

/* En bas au centre : la raison d'un refus de pose, puis la barre de construction. */

.bas {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    align-items: center;
}

.raison {
    margin-bottom: 12px;
    max-width: 416px;
}

.barre-contenu {
    align-items: center;
    padding: 21px 18px;
}

.cartes {
    flex-direction: row;
    justify-content: center;
}

.onglets {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.carte {
    width: 188px;
    margin: 0 6px;
    padding: 10px 10px 13px 10px;
    align-items: center;
}

.carte-cout {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.carte-cout-ligne {
    flex-direction: row;
    align-items: center;
    margin: 0 8px;
}

.carte-cout-icone {
    width: 24px;
    height: 24px;
    margin-right: 5px;
}

.carte-vignette {
    align-self: stretch;
    height: 120px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-and-crop;
}

.onglet {
    min-width: 188px;
    height: 56px;
    margin: 0 6px;
    padding: 0 16px 3px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.onglet-icone {
    width: 34px;
    height: 34px;
    margin-right: 8px;
}

/* La fiche du lieu touché, en haut à droite ; le menu, quand il viendra, se posera au-dessus. */

.fiche {
    position: absolute;
    right: 24px;
    top: 20px;
    width: 320px;
}

.fiche-contenu {
    padding: 14px 16px 18px 18px;
}

.fiche-tete {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

/* L'enseigne : le nom du lieu sur une tuile de lin, posée sur un ruban de brique dont les queues dépassent de chaque
   côté. Le lin porte le texte, la brique décore. */
.fiche-enseigne {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-height: 44px;
}

.fiche-ruban {
    position: absolute;
    left: 0;
    right: 0;
    top: 10px;
    bottom: 10px;
    background-image: url("Images/Ruban.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-scale: 0.25px;
}

.fiche-tuile {
    flex-shrink: 1;
    margin: 0 20px;
    padding: 4px 12px 5px 12px;
}

.fiche-titre {
    flex-shrink: 1;
    -unity-text-align: middle-center;
}

.fiche-fermer {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-left: 10px;
    align-items: center;
    justify-content: center;
}

.fiche-croix {
    width: 20px;
    height: 20px;
    background-image: url("Icones/croix.asset");
}

.fiche-stock {
    margin-bottom: 8px;
}

.fiche-ligne {
    flex-direction: row;
    align-items: center;
    padding: 6px 14px 6px 10px;
    margin-bottom: 6px;
}

.fiche-icone {
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.fiche-ligne-nom {
    flex-grow: 1;
}

.fiche-poste {
    margin: 4px 0 14px 2px;
}

/* Le poste, puis les icônes de ses tâches, dans son ordre ; leur nom en infobulle. */
.fiche-poste-ligne {
    flex-direction: row;
    align-items: center;
}

.fiche-poste-taches {
    flex-direction: row;
    margin-left: 6px;
}

.fiche-tache {
    width: 20px;
    height: 20px;
    margin-left: 6px;
}

.fiche-bouton {
    height: 52px;
    padding: 0 16px 3px 16px;
    align-items: center;
    justify-content: center;
}

/* Le stock en fanions sous une tringle, en haut au centre ; la tringle déborde de 30 px de chaque côté. */

.stock {
    position: absolute;
    left: 0;
    right: 0;
    top: 24px;
    align-items: center;
}

.stock-corps {
    padding: 0 30px;
}

.tringle {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 14px;
}

.pommeau {
    position: absolute;
    top: -4px;
    width: 22px;
    height: 22px;
}

.pommeau-gauche {
    left: -9px;
}

.pommeau-droit {
    right: -9px;
}

.fanions {
    flex-direction: row;
    justify-content: center;
    padding-top: 12px;
}

/* Une petite vie (HudLife) : chaque fanion se balance sous sa tringle, de ±1,5° en 3,6 s, décalé du précédent. */
.fanion {
    min-width: 112px;
    margin: 0 9px;
    padding: 18px 12px 22px 8px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transform-origin: 50% 0;
    --balancement: 1.5;
    --balancement-duree: 3.6;
    --balancement-decalage: 0.9;
}

.fanion-icone {
    width: 40px;
    height: 40px;
    margin-right: 6px;
}

.fanion .nombre {
    min-width: 36px;
    -unity-text-align: middle-right;
}

/* L'infobulle : placée par son code, sous ou au-dessus de ce qu'on survole. */

.infobulle {
    position: absolute;
    max-width: 320px;
}

/* L'astuce, en bas à gauche : le portrait de la Chimère et une phrase. Sa largeur est fixe : un texte qui revient à
   la ligne dans un bloc qui rétrécit serait mesuré à sa largeur d'avant, et sa dernière ligne sortirait du cadre. */

.astuce {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 416px;
    transition-property: translate, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
}

/* Une petite vie : une astuce nouvelle arrive en glissant de la gauche. */
.astuce-arrivee {
    translate: -24px 0;
    opacity: 0;
}

.astuce-contenu {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px 10px 10px;
}

.astuce-tuile {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.astuce-portrait {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-and-crop;
}

.astuce-texte {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-left: 12px;
}

/* Le cadre qu'on tire avec l'outil « Retirer » : du lin translucide bordé de bois (remplaçant simple). */
.cadre-selection {
    position: absolute;
    background-color: rgba(251, 243, 228, 0.2);
    border-width: 2px;
    border-color: var(--bois);
    border-radius: 4px;
}
