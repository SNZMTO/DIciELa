/* Le HUD (GDD, section 16 ; décision 144) : chaque bloc tient à son coin ou à son bord, à 24 px du bord de l'écran,
   20 en haut ; le milieu reste libre. Ici, seulement la place des blocs : leurs matières, leurs couleurs et leurs
   textes viennent de Fusion.uss. */

.ecran {
    flex-grow: 1;
}

/* La journée, en haut à gauche. */

.journee {
    position: absolute;
    left: 24px;
    top: 20px;
}

.journee-contenu {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px 10px 10px;
}

.journee-tuile {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.journee-icone {
    width: 42px;
    height: 42px;
    background-image: url("Icones/soleil.asset");
}

.journee-textes {
    margin-left: 12px;
}

.journee-ligne {
    flex-direction: row;
    align-items: center;
}

.journee-point {
    width: 4px;
    height: 4px;
    margin: 2px 8px 0 8px;
    background-color: var(--douce);
}

.jauge {
    width: 176px;
    height: 16px;
    margin-top: 10px;
}

/* En bas au centre : la raison d'un refus de pose, puis la barre de construction. */

.bas {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    align-items: center;
}

.raison {
    margin-bottom: 12px;
    max-width: 416px;
}

/* Une raison plus large que la bulle passe à la ligne, centrée, au lieu d'en déborder. */
.raison .libelle {
    white-space: normal;
    -unity-text-align: upper-center;
}

.barre-contenu {
    align-items: center;
    padding: 21px 18px;
}

.cartes {
    flex-direction: row;
    justify-content: center;
}

.onglets {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.carte {
    width: 188px;
    margin: 0 6px;
    padding: 10px 10px 13px 10px;
    align-items: center;
}

/* Le nom d'une carte, et à côté ce qu'elle offre (ses lits) ; à l'étroit, les lits passent dessous, au milieu. UI
   Toolkit n'a pas d'écart (gap) : chaque élément a 6 px de chaque côté, que la marge négative de la ligne rend. */
.carte-titre {
    align-self: stretch;
    margin: 0 -6px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

/* Ses textes perdent les retraits que le thème d'Unity donne à chaque texte : l'écart est celui de la maquette. */
.carte-titre .unity-label {
    margin: 0;
    padding: 0;
}

.carte-titre > .carte-nom, .carte-titre > .carte-lits {
    margin: 1px 6px;
}

.carte-lits {
    flex-direction: row;
    align-items: center;
}

.carte-lits-icone {
    width: 22px;
    height: 22px;
    margin-right: 5px;
    background-image: url("Icones/lit.asset");
}

.carte-cout {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.carte-cout-ligne {
    flex-direction: row;
    align-items: center;
    margin: 0 8px;
}

.carte-cout-icone {
    width: 24px;
    height: 24px;
    margin-right: 5px;
}

.carte-vignette {
    align-self: stretch;
    height: 120px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-and-crop;
}

/* Une carte sans modèle à photographier (la Place) : son icône, entière, au milieu de la vignette. */
.carte-vignette-icone {
    -unity-background-scale-mode: scale-to-fit;
}

/* La barre des outils de sol (décisions 206, 210, 214 et 216), la Place et Chemins, à la place du panneau Construire
   fermé : au-dessus, ce que l'outil pose (la zone, les sols, chacun sa vignette) ; puis ses modes en familles, en
   feutres, chacun son icône et sa touche, son nom et son usage dans l'infobulle ; dessous, les options du mode pris (les
   formes du mode Forme en petits feutres, la taille du pinceau) ; puis la superficie et les places de charrette dans des
   creux de lin. Étroite, elle tient entre l'astuce et l'icône des outils dès 1280 × 720. */
.place-encres {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 10px;
}

/* La vignette d'un sol : la texture de son calque, un remplaçant. */
.place-encre-vignette {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    -unity-background-scale-mode: scale-and-crop;
}

.place-modes {
    flex-direction: row;
    justify-content: center;
}

.place-mode {
    width: 56px;
    height: 56px;
    margin: 0 5px;
    align-items: center;
    justify-content: center;
}

.place-mode-icone {
    width: 32px;
    height: 32px;
}

.place-options {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 10px;
}

.place-formes {
    flex-direction: row;
}

.place-option {
    width: 44px;
    height: 44px;
    margin: 0 4px;
    align-items: center;
    justify-content: center;
}

.place-valeurs {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

.place-icone-brush {
    background-image: url("Icones/pinceau.asset");
}

.place-icone-eraser {
    background-image: url("Icones/gomme.asset");
}

.place-icone-trace {
    background-image: url("Icones/trace.asset");
}

.place-icone-shape {
    background-image: url("Icones/forme.asset");
}

.place-forme-disc {
    background-image: url("Icones/cercle.asset");
}

.place-forme-box {
    background-image: url("Icones/rectangle.asset");
}

.place-icone-cartspot {
    background-image: url("Icones/place-charrette.asset");
}

.place-icone-superficie {
    background-image: url("Icones/place.asset");
}

.place-valeur {
    flex-direction: row;
    align-items: center;
    height: 40px;
    margin: 0 4px;
    padding: 0 8px;
}

.place-valeur-icone {
    width: 20px;
    height: 20px;
    margin-right: 5px;
}

.onglet {
    min-width: 188px;
    height: 56px;
    margin: 0 6px;
    padding: 0 16px 3px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.onglet-icone {
    width: 34px;
    height: 34px;
    margin-right: 8px;
}

/* La fiche du lieu touché, en haut à droite ; le menu, quand il viendra, se posera au-dessus. */

.fiche {
    position: absolute;
    right: 24px;
    top: 20px;
    width: 300px;
}

.fiche-contenu {
    padding: 14px 16px 18px 18px;
}

.fiche-tete {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.fiche-titre {
    flex-shrink: 1;
}

.fiche-fermer {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-left: 10px;
    align-items: center;
    justify-content: center;
}

.fiche-croix {
    width: 20px;
    height: 20px;
    background-image: url("Icones/croix.asset");
}

.fiche-stock {
    margin-bottom: 8px;
}

.fiche-ligne {
    flex-direction: row;
    align-items: center;
    padding: 6px 14px 6px 10px;
    margin-bottom: 6px;
}

.fiche-icone {
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.fiche-ligne-nom {
    flex-grow: 1;
}

.fiche-poste {
    margin: 4px 0 14px 2px;
}

/* Les boutons de la fiche, l'un sous l'autre : 8 px sous chacun, que le bloc reprend au dernier. */

.fiche-actions {
    margin-bottom: -8px;
}

.fiche-bouton {
    height: 52px;
    padding: 0 16px 3px 16px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
}

/* Le stock en fanions sous une tringle, en haut au centre ; la tringle déborde de 30 px de chaque côté. */

.stock {
    position: absolute;
    left: 0;
    right: 0;
    top: 24px;
    align-items: center;
}

.stock-corps {
    padding: 0 30px;
}

.tringle {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 14px;
}

.pommeau {
    position: absolute;
    top: -4px;
    width: 22px;
    height: 22px;
}

.pommeau-gauche {
    left: -9px;
}

.pommeau-droit {
    right: -9px;
}

.fanions {
    flex-direction: row;
    justify-content: center;
    padding-top: 12px;
}

.fanion {
    min-width: 112px;
    margin: 0 9px;
    padding: 18px 12px 22px 8px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.fanion-icone {
    width: 40px;
    height: 40px;
    margin-right: 6px;
}

.fanion .nombre {
    min-width: 36px;
    -unity-text-align: middle-right;
}

/* L'infobulle : placée par son code, sous ou au-dessus de ce qu'on survole. */

.infobulle {
    position: absolute;
    max-width: 320px;
}

/* L'astuce, en bas à gauche : le portrait de la Chimère et une phrase. Sa largeur est fixe : un texte qui revient à
   la ligne dans un bloc qui rétrécit serait mesuré à sa largeur d'avant, et sa dernière ligne sortirait du cadre. */

.astuce {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 416px;
}

.astuce-contenu {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px 10px 10px;
}

.astuce-tuile {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.astuce-portrait {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-and-crop;
}

.astuce-texte {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-left: 12px;
}

/* Le cadre qu'on tire avec l'outil « Retirer » : du lin translucide bordé de bois (remplaçant simple). */
.cadre-selection {
    position: absolute;
    background-color: rgba(251, 243, 228, 0.2);
    border-width: 2px;
    border-color: var(--bois);
    border-radius: 4px;
}

/* Les outils (décision 168) : leur icône en bas à droite, la touche de la roue sur une étiquette de lin. */
.outils {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 64px;
    height: 64px;
    padding-bottom: 3px;
    align-items: center;
    justify-content: center;
}

.outils-icone {
    width: 40px;
    height: 40px;
    background-image: url("Icones/outils.asset");
}

.touche {
    position: absolute;
    right: -8px;
    bottom: -8px;
    min-width: 30px;
    height: 30px;
    padding: 0 7px;
    align-items: center;
    justify-content: center;
}

/* La roue des outils : un fond plein écran qui prend le pointeur tant qu'elle est ouverte ; autour du point où elle
   s'ouvre, un plateau octogonal (huit côtés, huit places d'outils), chaque outil à sa place fixe (Construire en haut,
   Retirer en bas), la bulle de l'outil visé au milieu ; l'outil visé grossit.
   Fermée, elle reste en page, invisible : elle se mesure avant de s'ouvrir, pour tenir dans l'écran. Les outils se
   placent par leurs marges, pas par translate, que le feutre garde pour se soulever. */
.roue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --marge: 24;
}

.roue-fermee {
    visibility: hidden;
}

.roue-centre {
    position: absolute;
    width: 0;
    height: 0;
}

.roue-plateau {
    position: absolute;
    width: 364px;
    height: 364px;
    margin-left: -182px;
    margin-top: -182px;
}

.roue-outil {
    position: absolute;
    width: 76px;
    height: 76px;
    margin-left: -38px;
    margin-top: -38px;
    padding-bottom: 3px;
    align-items: center;
    justify-content: center;
}

.roue-outil.vise {
    scale: 1.15 1.15;
}

.roue-haut {
    left: 0;
    top: -132px;
}

.roue-bas {
    left: 0;
    top: 132px;
}

.roue-droite {
    left: 132px;
    top: 0;
}

.roue-gauche {
    left: -132px;
    top: 0;
}

.roue-icone {
    width: 46px;
    height: 46px;
}

/* Le marteau penche à gauche, la hache à droite : deux silhouettes qu'on ne confond pas. */
.marteau {
    background-image: url("Icones/batir.asset");
    scale: -1 1;
}

.hache {
    background-image: url("Icones/defricher.asset");
}

/* Quatre flèches qui partent du milieu : l'outil Déplacer, à droite de la roue. */
.fleches {
    background-image: url("Icones/deplacer.asset");
}

/* Un chemin qui serpente, en pointillés : l'outil Chemins, à gauche de la roue (un remplaçant simple). */
.chemins {
    background-image: url("Icones/chemins.asset");
}

.roue-bulle {
    position: absolute;
    translate: -50% -50%;
    max-width: 240px;
    align-items: center;
}

.roue-texte {
    -unity-text-align: middle-center;
}
