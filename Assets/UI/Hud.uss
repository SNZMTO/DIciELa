/* Le HUD (GDD, section 16 ; décision 144) : chaque bloc tient à son coin ou à son bord, à 24 px du bord de l'écran,
   20 en haut ; le milieu reste libre. Ici, seulement la place des blocs : leurs matières, leurs couleurs et leurs
   textes viennent de Fusion.uss. */

.ecran {
    flex-grow: 1;
}

/* La journée, en haut à gauche. */

.journee {
    position: absolute;
    left: 24px;
    top: 20px;
}

.journee-contenu {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px 10px 10px;
}

.journee-tuile {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.journee-icone {
    width: 42px;
    height: 42px;
    background-image: url("Icones/soleil.asset");
}

.journee-textes {
    margin-left: 12px;
}

.journee-ligne {
    flex-direction: row;
    align-items: center;
}

.journee-point {
    width: 4px;
    height: 4px;
    margin: 2px 8px 0 8px;
    background-color: var(--douce);
}

.jauge {
    width: 176px;
    height: 16px;
    margin-top: 10px;
}

/* En bas au centre : la raison d'un refus de pose, puis la barre de construction. */

.bas {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    align-items: center;
}

.raison {
    margin-bottom: 12px;
    max-width: 416px;
}

.barre-contenu {
    align-items: center;
    padding: 21px 18px;
}

.cartes {
    flex-direction: row;
    justify-content: center;
}

.onglets {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.carte {
    width: 188px;
    margin: 0 6px;
    padding: 10px 10px 13px 10px;
    align-items: center;
}

.carte-vignette {
    align-self: stretch;
    height: 120px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-and-crop;
}

.onglet {
    min-width: 188px;
    height: 56px;
    margin: 0 6px;
    padding: 0 16px 3px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.onglet-icone {
    width: 34px;
    height: 34px;
    margin-right: 8px;
}

/* La fiche du lieu touché, en haut à droite ; le menu, quand il viendra, se posera au-dessus. */

.fiche {
    position: absolute;
    right: 24px;
    top: 20px;
    width: 300px;
}

.fiche-contenu {
    padding: 14px 16px 18px 18px;
}

.fiche-tete {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.fiche-titre {
    flex-shrink: 1;
}

.fiche-fermer {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-left: 10px;
    align-items: center;
    justify-content: center;
}

.fiche-croix {
    width: 20px;
    height: 20px;
    background-image: url("Icones/croix.asset");
}

.fiche-stock {
    margin-bottom: 8px;
}

.fiche-ligne {
    flex-direction: row;
    align-items: center;
    padding: 6px 14px 6px 10px;
    margin-bottom: 6px;
}

.fiche-icone {
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.fiche-ligne-nom {
    flex-grow: 1;
}

.fiche-poste {
    margin: 4px 0 14px 2px;
}

.fiche-bouton {
    height: 52px;
    padding: 0 16px 3px 16px;
    align-items: center;
    justify-content: center;
}
