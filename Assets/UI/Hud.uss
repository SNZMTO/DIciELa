/* Le HUD (GDD, section 16 ; décision 144) : chaque bloc tient à son coin ou à son bord, à 24 px du bord de l'écran,
   20 en haut ; le milieu reste libre. Ici, seulement la place des blocs : leurs matières, leurs couleurs et leurs
   textes viennent de Fusion.uss. */

.ecran {
    flex-grow: 1;
}

/* La journée, en haut à gauche. */

.journee {
    position: absolute;
    left: 24px;
    top: 20px;
}

.journee-contenu {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px 10px 10px;
}

.journee-tuile {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.journee-icone {
    width: 42px;
    height: 42px;
    background-image: url("Icones/soleil.asset");
}

.journee-textes {
    margin-left: 12px;
}

.journee-ligne {
    flex-direction: row;
    align-items: center;
}

.journee-point {
    width: 4px;
    height: 4px;
    margin: 2px 8px 0 8px;
    background-color: var(--douce);
}

.jauge {
    width: 176px;
    height: 16px;
    margin-top: 10px;
}

/* En bas au centre : la raison d'un refus de pose, puis la barre de construction. */

.bas {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    align-items: center;
}

.raison {
    margin-bottom: 12px;
    max-width: 416px;
}

/* Une raison plus large que la bulle passe à la ligne, centrée, au lieu d'en déborder. */
.raison .libelle {
    white-space: normal;
    -unity-text-align: upper-center;
}

.barre-contenu {
    align-items: center;
    padding: 21px 18px;
}

.cartes {
    flex-direction: row;
    justify-content: center;
}

.onglets {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.carte {
    width: 188px;
    margin: 0 6px;
    padding: 10px 10px 13px 10px;
    align-items: center;
}

/* Le nom d'une carte, et à côté ce qu'elle offre (ses lits) ; à l'étroit, les lits passent dessous, au milieu. UI
   Toolkit n'a pas d'écart (gap) : chaque élément a 6 px de chaque côté, que la marge négative de la ligne rend. */
.carte-titre {
    align-self: stretch;
    margin: 0 -6px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

/* Ses textes perdent les retraits que le thème d'Unity donne à chaque texte : l'écart est celui de la maquette. */
.carte-titre .unity-label {
    margin: 0;
    padding: 0;
}

.carte-titre > .carte-nom, .carte-titre > .carte-lits {
    margin: 1px 6px;
}

.carte-lits {
    flex-direction: row;
    align-items: center;
}

.carte-lits-icone {
    width: 22px;
    height: 22px;
    margin-right: 5px;
    background-image: url("Icones/lit.asset");
}

.carte-cout {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.carte-cout-ligne {
    flex-direction: row;
    align-items: center;
    margin: 0 8px;
}

.carte-cout-icone {
    width: 24px;
    height: 24px;
    margin-right: 5px;
}

.carte-vignette {
    align-self: stretch;
    height: 120px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-and-crop;
}

.onglet {
    min-width: 188px;
    height: 56px;
    margin: 0 6px;
    padding: 0 16px 3px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.onglet-icone {
    width: 34px;
    height: 34px;
    margin-right: 8px;
}

/* La fiche du lieu touché, en haut à droite ; le menu, quand il viendra, se posera au-dessus. */

.fiche {
    position: absolute;
    right: 24px;
    top: 20px;
    width: 300px;
}

.fiche-contenu {
    padding: 14px 16px 18px 18px;
}

.fiche-tete {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.fiche-titre {
    flex-shrink: 1;
}

.fiche-fermer {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-left: 10px;
    align-items: center;
    justify-content: center;
}

.fiche-croix {
    width: 20px;
    height: 20px;
    background-image: url("Icones/croix.asset");
}

.fiche-stock {
    margin-bottom: 8px;
}

.fiche-ligne {
    flex-direction: row;
    align-items: center;
    padding: 6px 14px 6px 10px;
    margin-bottom: 6px;
}

.fiche-icone {
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.fiche-ligne-nom {
    flex-grow: 1;
}

.fiche-poste {
    margin: 4px 0 14px 2px;
}

/* Les boutons de la fiche, l'un sous l'autre : 8 px sous chacun, que le bloc reprend au dernier. */

.fiche-actions {
    margin-bottom: -8px;
}

.fiche-bouton {
    height: 52px;
    padding: 0 16px 3px 16px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
}

/* Le stock en fanions sous une tringle, en haut au centre ; la tringle déborde de 30 px de chaque côté. */

.stock {
    position: absolute;
    left: 0;
    right: 0;
    top: 24px;
    align-items: center;
}

.stock-corps {
    padding: 0 30px;
}

.tringle {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 14px;
}

.pommeau {
    position: absolute;
    top: -4px;
    width: 22px;
    height: 22px;
}

.pommeau-gauche {
    left: -9px;
}

.pommeau-droit {
    right: -9px;
}

.fanions {
    flex-direction: row;
    justify-content: center;
    padding-top: 12px;
}

.fanion {
    min-width: 112px;
    margin: 0 9px;
    padding: 18px 12px 22px 8px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.fanion-icone {
    width: 40px;
    height: 40px;
    margin-right: 6px;
}

.fanion .nombre {
    min-width: 36px;
    -unity-text-align: middle-right;
}

/* L'infobulle : placée par son code, sous ou au-dessus de ce qu'on survole. */

.infobulle {
    position: absolute;
    max-width: 320px;
}

/* L'astuce, en bas à gauche : le portrait de la Chimère et une phrase. Sa largeur est fixe : un texte qui revient à
   la ligne dans un bloc qui rétrécit serait mesuré à sa largeur d'avant, et sa dernière ligne sortirait du cadre. */

.astuce {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 416px;
}

.astuce-contenu {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px 10px 10px;
}

.astuce-tuile {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.astuce-portrait {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-and-crop;
}

.astuce-texte {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-left: 12px;
}

/* Le cadre qu'on tire avec l'outil « Retirer » : du lin translucide bordé de bois (remplaçant simple). */
.cadre-selection {
    position: absolute;
    background-color: rgba(251, 243, 228, 0.2);
    border-width: 2px;
    border-color: var(--bois);
    border-radius: 4px;
}

/* Les outils (décision 168) : leur icône en bas à droite, la touche de la roue sur une étiquette de lin. */
.outils {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 64px;
    height: 64px;
    padding-bottom: 3px;
    align-items: center;
    justify-content: center;
}

.outils-icone {
    width: 40px;
    height: 40px;
    background-image: url("Icones/outils.asset");
}

.touche {
    position: absolute;
    right: -8px;
    bottom: -8px;
    min-width: 30px;
    height: 30px;
    padding: 0 7px;
    align-items: center;
    justify-content: center;
}

/* La carte de l'outil en main (décision 221), à gauche de l'icône des outils, en bas : un feutre de lin ; l'icône de
   l'outil sur une tuile de sa couleur ; son nom et son mode ; ses puces, qui passent à la ligne ; la raison d'un refus.
   Sa largeur est fixe : une raison qui revient à la ligne dans un bloc qui rétrécit sortirait du cadre. Elle s'efface
   tant que la roue est ouverte. */
.carte-outil {
    position: absolute;
    right: 100px;
    bottom: 24px;
    width: 400px;
    flex-direction: row;
    align-items: center;
    padding: 10px 14px 13px 10px;
}

.carte-outil-effacee {
    opacity: 0.16;
}

/* Elle glisse quand on prend un outil (depuis la droite, petite et transparente) et quand on le lâche (décision 225),
   autour de son coin bas-droit, près de l'icône des outils ; elle s'efface en fondu quand la roue s'ouvre. */
.feutre.carte-outil {
    transform-origin: right bottom;
    transition-property: translate, scale, opacity;
    transition-duration: 0.16s, 0.16s, 0.16s;
    transition-timing-function: ease-out-cubic, ease-out-back, ease-out-cubic;
}

.feutre.carte-outil.carte-outil-entree {
    translate: 18px 0;
    scale: 0.9 0.9;
    opacity: 0;
    transition-duration: 0s;
}

.feutre.carte-outil.carte-outil-sortie {
    translate: 18px 0;
    opacity: 0;
}

.carte-outil-tuile {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.carte-outil-icone {
    width: 36px;
    height: 36px;
}

.carte-outil-textes {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-left: 12px;
}

/* Son nom, puis son mode, qui passe dessous s'il ne tient pas à côté. */
.carte-outil-tete {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.carte-outil-ligne {
    flex-direction: row;
    align-items: center;
}

.carte-outil-point {
    width: 4px;
    height: 4px;
    margin: 2px 8px 0 8px;
    background-color: var(--douce);
}

.carte-outil-mode-icone {
    width: 24px;
    height: 24px;
    margin-right: 4px;
}

.carte-outil-puces {
    flex-direction: row;
    flex-wrap: wrap;
}

.carte-outil-puce {
    flex-direction: row;
    align-items: center;
    height: 26px;
    margin: 4px 4px 0 0;
    padding: 0 7px;
}

.carte-outil-puce-icone {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}

.carte-outil-raison {
    margin-top: 4px;
    white-space: normal;
}

/* Le curseur des outils (décision 221) : au-dessus de tout, et le pointeur le traverse ; placé par translate à chaque
   image, jamais par left et top, qui referaient la mise en page. Sa silhouette, à la couleur de son outil ; ses
   pastilles en bas à droite ; la croix d'un refus. */
.curseur {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
}

/* Le pop du curseur quand l'outil change : il part gros et revient en ressort, autour de sa pointe (décision 225). */
.curseur {
    transition-property: scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-back;
}

.curseur.curseur-pop {
    scale: 1.45 1.45;
    transition-duration: 0s;
}

/* L'éclaboussure d'un geste qui agit : un anneau à la couleur de l'outil, qui s'ouvre et s'efface (décision 225) ;
   au repos, grand et transparent. */
.eclaboussure {
    position: absolute;
    left: 0;
    top: 0;
    width: 28px;
    height: 28px;
    margin-left: -14px;
    margin-top: -14px;
    border-radius: 14px;
    border-width: 3px;
    scale: 1.7 1.7;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
}

.eclaboussure.eclaboussure-depart {
    scale: 0.2 0.2;
    opacity: 1;
    transition-duration: 0s;
}

.curseur-icone {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
}

.curseur-pastilles {
    position: absolute;
    left: 28px;
    top: 30px;
    flex-direction: row;
}

.curseur-pastille {
    width: 20px;
    height: 20px;
    margin-right: 2px;
    align-items: center;
    justify-content: center;
}

.curseur-pastille-icone {
    width: 13px;
    height: 13px;
}

.curseur-refus-trait {
    position: absolute;
    left: 4px;
    top: 8.5px;
    width: 12px;
    height: 3px;
    background-color: var(--lin);
}

.curseur-refus-montant {
    rotate: 45deg;
}

.curseur-refus-descendant {
    rotate: -45deg;
}

/* Les silhouettes des curseurs (CursorIcons), leur pointe dans ToolCursorShapes. */
.curseur-marteau {
    background-image: url("Icones/curseur-marteau.asset");
}

.curseur-hache {
    background-image: url("Icones/curseur-hache.asset");
}

.curseur-main {
    background-image: url("Icones/curseur-main.asset");
}

.curseur-pinceau {
    background-image: url("Icones/curseur-pinceau.asset");
}

.curseur-gomme {
    background-image: url("Icones/curseur-gomme.asset");
}

.curseur-plume {
    background-image: url("Icones/curseur-plume.asset");
}

.curseur-viseur {
    background-image: url("Icones/curseur-viseur.asset");
}

.curseur-place-charrette {
    background-image: url("Icones/curseur-place-charrette.asset");
}

/* La roue (décision 221) : un fond plein écran qui prend le pointeur tant qu'elle est ouverte ; autour du point où elle
   s'ouvre, un plateau octogonal (huit côtés, huit cases), chaque case à sa place fixe, sur un cercle de --rayon px, la
   bulle de ce qu'on vise au milieu ; la case visée grossit et déplie ses options en jetons, sur un cercle de
   --rayon-eventail px, écartés de --ecart degrés. Fermée, elle reste en page, invisible : elle se mesure avant de
   s'ouvrir, pour tenir dans l'écran. Les cases se placent par left et top, pas par translate, que le feutre garde pour
   se soulever. */
.roue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --marge: 24;
    --rayon: 132;
    --rayon-eventail: 226;
    --ecart: 30;
}

.roue-fermee {
    visibility: hidden;
}

/* Ses mouvements (décision 225), 200 ms au plus : elle s'ouvre en ressort, petite, penchée et transparente, ses cases
   l'une après l'autre, ses jetons depuis leur case ; elle se retourne comme une pièce d'un étage à l'autre ; la case
   qu'on se met à viser grossit et se dandine. Les feutres de la roue ont leurs propres transitions, plus précises que
   celle du feutre (le soulèvement). */
.roue-centre {
    transition-property: scale, rotate, opacity;
    transition-duration: 0.18s, 0.18s, 0.12s;
    transition-timing-function: ease-out-back, ease-out-back, ease-out-cubic;
}

.roue-centre.roue-entree {
    scale: 0.55 0.55;
    rotate: -12deg;
    opacity: 0;
    transition-duration: 0s;
}

.roue-centre.roue-retournee {
    scale: 0.05 1;
    transition-duration: 0s;
}

.feutre.roue-outil, .feutre.roue-jeton {
    transition-property: translate, scale, opacity, rotate;
    transition-duration: 0.12s, 0.13s, 0.13s, 0.07s;
    transition-timing-function: ease-out-cubic, ease-out-back, ease-out-cubic, ease-in-out-sine;
}

.feutre.roue-outil.roue-entree, .feutre.roue-jeton.roue-entree {
    scale: 0.2 0.2;
    opacity: 0;
    transition-duration: 0s;
}

.dandine-gauche {
    rotate: -9deg;
}

.dandine-droite {
    rotate: 6deg;
}

/* L'icône prise saute de la roue au curseur : posée sur sa case, grossie, elle file vers le pointeur en rapetissant et
   s'efface ; au repos, petite et transparente. */
.roue-vol {
    position: absolute;
    left: 0;
    top: 0;
    width: 46px;
    height: 46px;
    margin-left: -23px;
    margin-top: -23px;
    scale: 0.5 0.5;
    opacity: 0;
    transition-property: translate, scale, opacity;
    transition-duration: 0.18s;
    transition-timing-function: ease-in-cubic;
}

.roue-vol.roue-vol-depart {
    scale: 1.25 1.25;
    opacity: 1;
    transition-duration: 0s;
}

.roue-centre {
    position: absolute;
    width: 0;
    height: 0;
}

.roue-plateau {
    position: absolute;
    width: 364px;
    height: 364px;
    margin-left: -182px;
    margin-top: -182px;
}

.roue-outil {
    position: absolute;
    width: 76px;
    height: 76px;
    margin-left: -38px;
    margin-top: -38px;
    padding-bottom: 3px;
    align-items: center;
    justify-content: center;
}

.roue-outil.vise {
    scale: 1.15 1.15;
}

.roue-boite {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

/* Une option d'une case : un jeton de feutre de son éventail, au-delà du plateau ; sa pastille dit un nombre. */
.roue-jeton {
    position: absolute;
    width: 60px;
    height: 60px;
    margin-left: -30px;
    margin-top: -30px;
    padding-bottom: 3px;
    align-items: center;
    justify-content: center;
}

.roue-jeton.vise {
    scale: 1.18 1.18;
}

.roue-jeton-icone {
    width: 34px;
    height: 34px;
}

.roue-vignette {
    border-radius: 6px;
    -unity-background-scale-mode: scale-and-crop;
}

.roue-pastille {
    position: absolute;
    right: -8px;
    top: -8px;
    min-width: 26px;
    height: 26px;
    padding: 0 5px;
    align-items: center;
    justify-content: center;
}

.roue-icone {
    width: 46px;
    height: 46px;
}

/* Le marteau penche à gauche, la hache à droite : deux silhouettes qu'on ne confond pas. */
.marteau {
    background-image: url("Icones/batir.asset");
    scale: -1 1;
}

.hache {
    background-image: url("Icones/defricher.asset");
}

/* Quatre flèches qui partent du milieu : l'outil Déplacer, à droite de la roue. */
.fleches {
    background-image: url("Icones/deplacer.asset");
}

/* Un chemin qui serpente, en pointillés : l'outil Chemins, à gauche de la roue (un remplaçant simple). */
.chemins {
    background-image: url("Icones/chemins.asset");
}

/* La Place, en haut à gauche de la roue des outils : la carte de sa zone et de deux places de charrette. */
.roue-place {
    background-image: url("Icones/place.asset");
}

/* La case Outils, en bas à gauche de la roue d'un outil : elle retourne la roue sur les outils. */
.roue-retour {
    background-image: url("Icones/outils.asset");
}

/* Les icônes des outils de sol (PaintIconClasses) : chaque mode, chaque forme, chaque style de tracé, chaque
   symétrie, la zone ; la roue et la carte les posent. */
.place-icone-brush {
    background-image: url("Icones/pinceau.asset");
}

.place-icone-eraser {
    background-image: url("Icones/gomme.asset");
}

.place-icone-trace {
    background-image: url("Icones/trace.asset");
}

.place-icone-shape {
    background-image: url("Icones/forme.asset");
}

.place-forme-disc {
    background-image: url("Icones/cercle.asset");
}

.place-forme-box {
    background-image: url("Icones/rectangle.asset");
}

.place-forme-polygon {
    background-image: url("Icones/polygone.asset");
}

.place-style-straight {
    background-image: url("Icones/droit.asset");
}

.place-style-curved {
    background-image: url("Icones/courbe.asset");
}

.place-symetrie-none {
    background-image: url("Icones/sans-symetrie.asset");
}

.place-symetrie-mirror {
    background-image: url("Icones/miroir.asset");
}

.place-symetrie-doublemirror {
    background-image: url("Icones/double-miroir.asset");
}

.place-symetrie-star {
    background-image: url("Icones/etoile.asset");
}

.place-icone-cartspot {
    background-image: url("Icones/place-charrette.asset");
}

.place-icone-superficie {
    background-image: url("Icones/place.asset");
}

.roue-bulle {
    position: absolute;
    translate: -50% -50%;
    max-width: 240px;
    align-items: center;
}

.roue-texte {
    -unity-text-align: middle-center;
}
