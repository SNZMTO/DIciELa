        <ui:Label name="reason" class="reason reason--hidden" picking-mode="Ignore" />
        <ui:VisualElement name="bar" class="bar bar--hidden">
            <ui:VisualElement name="structures" class="row" />
            <ui:VisualElement name="families" class="row" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
