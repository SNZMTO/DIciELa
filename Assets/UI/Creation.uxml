<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Creation.uss" />
    <ui:VisualElement name="screen" class="creation-ecran" picking-mode="Ignore">
        <Diciela.UI.WoodFrame name="panel" class="creation bloc-cache">
            <ui:VisualElement class="creation-contenu">
                <ui:Label name="title" class="t1 creation-titre" />
                <ui:VisualElement name="rows" class="creation-lignes" />
                <Diciela.UI.FeltButton name="confirm" class="feutre menthe pan-10 couture creation-valider">
                    <ui:Label name="confirm-text" class="action" picking-mode="Ignore" />
                </Diciela.UI.FeltButton>
            </ui:VisualElement>
        </Diciela.UI.WoodFrame>
    </ui:VisualElement>
</ui:UXML>
