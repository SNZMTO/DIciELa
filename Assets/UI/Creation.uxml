<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Creation.uss" />
    <ui:VisualElement name="screen" class="screen" picking-mode="Ignore">
        <ui:VisualElement name="panel" class="panel panel--hidden">
            <ui:Label name="title" class="title" />
            <ui:VisualElement name="rows" class="rows" />
            <ui:Button name="confirm" class="confirm" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
